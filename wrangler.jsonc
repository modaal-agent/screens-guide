// The Worker that serves dist/ at screens.guide (spec 001 §5.1). It runs no script: every
// request is a static asset. Spec 002 adds the script for /mcp and Markdown negotiation.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "screens-guide",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // dist/404.html, with status 404, for a path with no file.
    "not_found_handling": "404-page",
    // /devices/iphone-17 serves devices/iphone-17.html; /guide/ redirects to /guide.
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "screens.guide", "custom_domain": true }],
  // No usage data from wrangler to Cloudflare.
  "send_metrics": false
}
