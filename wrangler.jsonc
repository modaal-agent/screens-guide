// The Worker that serves dist/ at screens.guide (spec 001 §5.1, spec 002 §2). Static assets are
// served by Cloudflare without the script; the routes in run_worker_first run worker/index.ts.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "screens-guide",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // dist/404.html, with status 404, for a path with no file.
    "not_found_handling": "404-page",
    // /devices/iphone-17 serves devices/iphone-17.html; /guide/ redirects to /guide.
    "html_handling": "auto-trailing-slash",
    // The MCP server, the page routes and the counted files of spec 002 §3: RUN_WORKER_FIRST in
    // worker/routes.ts, which tests/hosting.test.ts compares with this list.
    "run_worker_first": [
      "/mcp",
      "/", "/guide", "/compare", "/runtimes", "/playground", "/agents", "/method", "/privacy", "/changelog", "/devices/*",
      "/data/*", "/llms.txt", "/llms-full.txt", "/*.md", "/skills/*"
    ]
  },
  "routes": [{ "pattern": "screens.guide", "custom_domain": true }],
  // /mcp's minute window: 100 requests per client address (spec 002 §2.6).
  "ratelimits": [{ "name": "MCP_MINUTE", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }],
  // /mcp's day window: one DailyCount object per client address, SQLite-backed.
  "durable_objects": { "bindings": [{ "name": "DAILY_COUNT", "class_name": "DailyCount" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyCount"] }],
  // Workers Logs: one invocation log, with the request's method and URL, for each request the
  // script runs for, kept at most 7 days. /privacy says so (spec 002 §6.1).
  "observability": { "enabled": true },
  // No usage data from wrangler to Cloudflare.
  "send_metrics": false
}
