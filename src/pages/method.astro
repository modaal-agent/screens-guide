---
import Base from '../layouts/Base.astro'
import { DATA } from '../lib/data.ts'

const runs = Object.entries(DATA.runs).sort(([, a], [, b]) => a.date.localeCompare(b.date))
const fields = [
  ['Window', 'UIWindow.bounds, read by a probe app', 'the window size of a Compose probe, from the display pixels and density (wm size, wm density)'],
  ['Pixels', 'the window times the screen scale (UIScreen.scale), equal to the display profile', 'wm size, rotated to the reading'],
  ['Safe-area insets', 'UIWindow.safeAreaInsets', 'WindowInsets.safeDrawing; WindowInsets.systemBars and displayCutout apart'],
  ['Corner radii, display profile', "the simulator's device profile, capabilities.plist", "dumpsys display, the display's RoundedCorner entries"],
  ['Corner radii, measured', "SwiftUI's concentricCornerRadii of a view that fills the window; on iOS 18.6 the corners of the view behind a full-screen sheet", 'not read'],
  ['Size classes', "the trait collection's horizontal and vertical size classes", 'currentWindowAdaptiveInfo and currentWindowAdaptiveInfoV2'],
  ['Status bar', "UIWindowScene.statusBarManager: statusBarFrame and isStatusBarHidden", 'dumpsys window, the statusBars inset source'],
  ['Navigation bar', "a UINavigationBar's frame in the window, with an inline and with a large title", "Material 3's TopAppBar inside the safe area"],
  ['Tab bar', "a UITabBarController's tab bar; the capsule is the depth-0 view whose class ends in PlatterView", "Material 3's NavigationBar, edge to edge"],
  ['Content margin', "SwiftUI's contentMargins(for: .container)", 'not read'],
  ['Reserved regions', 'UIView.reservedRegions(kind: .occlusion), active and inactive', "dumpsys display, the cutout's bounding rectangle"],
  ['Fold', "the .division reserved region and the hinge's status", "WindowInfoTracker's FoldingFeature"],
]
---
<Base title="How each value is read" description="The runs behind the dataset, and the API or command that reads each value on iOS and Android.">
  <h1>How each value is read</h1>
  <p class="lede">
    Every value comes from a probe app or a command run on an Xcode simulator or an Android
    emulator. Nothing is copied from a specification sheet. The probe apps are not published; the
    table names the API or command behind each value, so it can be read again with your own code.
  </p>

  <h2>Fields</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Field</th><th scope="col">iOS</th><th scope="col">Android</th></tr></thead>
      <tbody>
        {fields.map(([f, ios, android]) => <tr><th scope="row">{f}</th><td>{ios}</td><td>{android}</td></tr>)}
      </tbody>
    </table>
  </div>

  <h2>Runs</h2>
  <p>A reading's <code>measured.runs</code> names the runs its values come from. Two runs that read the same value on the same build must agree within 0.01, or the export stops.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Run</th><th scope="col">Date</th><th scope="col">On</th><th scope="col">What it reads</th></tr></thead>
      <tbody>
        {runs.map(([id, run]) => <tr><th scope="row"><code>{id}</code></th><td>{run.date}</td><td>{run.on}</td><td>{run.what}</td></tr>)}
      </tbody>
    </table>
  </div>

  <h2>What no run measured</h2>
  <ul class="prose">
    <li>Keyboard heights.</li>
    <li>Display Zoom on iPhone, and iPad Split View and Stage Manager windows.</li>
    <li>Android at a font scale other than the default.</li>
    <li>The corner radii of the Pixel Fold and the small Android phone, whose emulators report none, and of the Pixel Tablet.</li>
    <li>Landscape on the devices whose pages show portrait only.</li>
    <li>Physical size, weight and pixel density per inch: spec sheets publish them, and no run reads them.</li>
  </ul>
</Base>
