---
import Base from '../layouts/Base.astro'
import type { Device, Reading } from '../lib/dataset.ts'
import {
  DEVICES, SCREEN_LABEL, compareRuntimes, corners, currentReadings, device, headlineReading, insets, num, otherOrientation,
  runtimeLabel, scaleLabel, size,
} from '../lib/data.ts'

const iphone17 = headlineReading(device('iphone-17'))
const iphone17Scale = device('iphone-17').displays.main.scale ?? 1
const pixel8 = headlineReading(device('pixel-8'))
const pixel8Density = device('pixel-8').displays.main.density ?? 160
const pixel8StatusPx = Math.round((pixel8.safeAreaInsets?.top ?? 0) * pixel8Density / 160)

// The readings where the display profile's corner radius and the measured one differ.
const cornerPairs = DEVICES.flatMap((d) => {
  const seen = new Set<string>()
  return d.readings
    .filter((r) => r.rotation === 0 && r.cornerRadii.profile && r.cornerRadii.measured)
    .filter((r) => corners(r.cornerRadii.profile!) !== corners(r.cornerRadii.measured!))
    .filter((r) => !seen.has(r.runtime.version) && !!seen.add(r.runtime.version))
    .map((r) => ({ d, r }))
})

// Bars by runtime on the device read on the most runtimes.
function byRuntime(d: Device, rotation: number): Reading[] {
  const rows = d.readings.filter((r) => r.screen === 'main' && r.rotation === rotation)
  return rows.sort((a, b) => compareRuntimes(a.runtime, b.runtime))
}
const barDevice = device('iphone-16')
const barRows = byRuntime(barDevice, 0)

function latest(d: Device, pick: (r: Reading) => unknown): Reading | undefined {
  return [...d.readings].sort((a, b) => compareRuntimes(b.runtime, a.runtime)).find((r) => pick(r) !== null && pick(r) !== undefined)
}

const foldables = DEVICES.filter((d) => d.kind === 'foldable')
---
<Base title="Points, pixels, safe areas and corner radii: a guide" description="How screen sizes, pixel scales, corner radii, safe-area insets, system bars, margins, size classes and folds work on iOS and Android, with the measured numbers.">
  <h1>A guide to the numbers</h1>
  <p class="lede">
    What each measurement means and how a layout uses it, on iOS and Android. Every number here is
    a reading from the dataset; the device pages have every runtime.
  </p>
  <nav aria-label="On this page">
    <a href="#units">Points, pixels and dp</a> · <a href="#corners">Corner radii</a> · <a href="#safe-area">Safe areas</a> · <a href="#bars">System bars</a> · <a href="#margins">Margins</a> · <a href="#size-classes">Size classes</a> · <a href="#foldables">Foldables</a>
  </nav>

  <h2 id="units">Points, pixels and dp</h2>
  <div class="prose">
    <p>
      iOS lays out in points. The iPhone 17's window is {size(iphone17.window)} pt and {size(iphone17.pixels)}
      px: {num(iphone17Scale)} pixels per point. Android lays out in dp, and one dp is dpi ÷ 160 pixels. The Pixel 8 has {pixel8Density} dpi, so its {size(pixel8.pixels)} px
      window is {size(pixel8.window)} dp, and its {pixel8StatusPx} px status bar inset is {num(pixel8.safeAreaInsets?.top ?? 0)}
      dp. Android sizes are rarely whole dp; the dataset keeps
      two decimals.
    </p>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Device</th><th scope="col">Window</th><th scope="col">Pixels</th><th scope="col">Scale</th></tr></thead>
      <tbody>
        {DEVICES.map((d) => {
          const r = headlineReading(d)
          return <tr><th scope="row"><a href={`/devices/${d.id}`}>{d.name}</a></th><td class="num">{size(r.window)} {d.unit}</td><td class="num">{size(r.pixels)}</td><td class="num">{scaleLabel(d)}</td></tr>
        })}
      </tbody>
    </table>
  </div>

  <h2 id="corners">Corner radii</h2>
  <div class="prose">
    <p>
      The display's rounded corners clip what is drawn under them. Two readings give a radius: the
      display profile the simulator or emulator draws the display from, and, on iOS, SwiftUI's <code>concentricCornerRadii</code>
      for a view that fills the window (on iOS 18.6, the corners of
      the view behind a full-screen sheet). They agree on the iPhones; where they differ, both are
      below. The <a href="/playground">corner fit</a> works out how close a frame's corner can come.
    </p>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Device</th><th scope="col">Runtime</th><th scope="col">Display profile</th><th scope="col">Measured</th></tr></thead>
      <tbody>
        {cornerPairs.map(({ d, r }) => (
          <tr><th scope="row"><a href={`/devices/${d.id}`}>{d.name}</a></th><td>{runtimeLabel(r.runtime)}</td><td class="num">{corners(r.cornerRadii.profile!)}</td><td class="num">{corners(r.cornerRadii.measured!)}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="safe-area">Safe areas</h2>
  <div class="prose">
    <p>
      The safe-area insets are where the system draws the status bar, the home indicator or gesture
      bar, the cutout and side columns. Lay text, controls and tap targets inside the safe area, and
      let backgrounds run to the window's edges. On Android the safe area is <code>WindowInsets.safeDrawing</code>:
      per side, the larger of the system bars and the cutout.
      Insets are top / bottom / left / right, from each device's current reading.
    </p>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Device</th><th scope="col">Screen</th><th scope="col">Natural orientation</th><th scope="col">Turned</th></tr></thead>
      <tbody>
        {DEVICES.flatMap((d) => {
          const screens = d.screens ? d.screens.map((s) => s.id) : ['main']
          return screens.map((screen) => {
            const own = currentReadings(d).filter((r) => r.screen === screen).sort((a, b) => a.rotation - b.rotation)
            const first = own[0]
            const turned = first ? otherOrientation(d, first) : undefined
            return first && (
              <tr>
                <th scope="row"><a href={`/devices/${d.id}`}>{d.name}</a></th>
                <td>{SCREEN_LABEL[screen]}</td>
                <td class="num">{first.safeAreaInsets ? insets(first.safeAreaInsets) : '—'}</td>
                <td class="num">{turned?.safeAreaInsets ? insets(turned.safeAreaInsets) : '—'}</td>
              </tr>
            )
          })
        })}
      </tbody>
    </table>
  </div>

  <h2 id="bars">System bars</h2>
  <div class="prose">
    <p>
      iOS's navigation bar and tab bar changed shape between iOS 18 and iOS 26. The {barDevice.name},
      read on every runtime from iOS 18.6, in portrait (top edge and height; the tab bar's gap to the
      window's bottom edge):
    </p>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Runtime</th><th scope="col">Inline title bar</th><th scope="col">Large title bar</th><th scope="col">Tab bar</th></tr></thead>
      <tbody>
        {barRows.map((r) => (
          <tr class={r.runtime.prerelease ? 'beta' : undefined}>
            <th scope="row">{runtimeLabel(r.runtime)} <code>{r.runtime.build}</code></th>
            <td class="num">{r.navigationBar.inline ? `${num(r.navigationBar.inline.top)}, ${num(r.navigationBar.inline.height)}` : '—'}</td>
            <td class="num">{r.navigationBar.large ? `${num(r.navigationBar.large.top)}, ${num(r.navigationBar.large.height)}` : '—'}</td>
            <td class="num">{r.tabBar ? `${r.tabBar.style}, ${num(r.tabBar.height)} tall, ${num(r.tabBar.bottom)} above the bottom edge` : '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="prose">
    <p>
      On Android, Material 3's top app bar sits below the status bar inset, and its colour runs up
      under the status bar; the navigation bar's background runs to the bottom edge. On the Pixel 8 in
      portrait the top app bar is {num(pixel8.navigationBar.inline?.height ?? 0)} dp below a {num(pixel8.navigationBar.inline?.top ?? 0)}
      dp inset, and the navigation bar is {num(pixel8.tabBar?.height ?? 0)} dp tall including the {num(pixel8.safeAreaInsets?.bottom ?? 0)}
      dp bottom inset.
    </p>
  </div>

  <h2 id="margins">Margins</h2>
  <div class="prose">
    <p>
      SwiftUI's <code>contentMargins(for: .container)</code> is the system's margin between a view
      that spans the window and its content, on iOS 27.1 and later. Per device, from its newest
      reading in its natural orientation:
    </p>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Device</th><th scope="col">Content margin</th><th scope="col">Runtime</th></tr></thead>
      <tbody>
        {DEVICES.filter((d) => d.platform === 'ios').map((d) => {
          const r = latest(d, (x) => (x.rotation === 0 ? x.contentMargin : null))
          return r && <tr><th scope="row"><a href={`/devices/${d.id}`}>{d.name}</a></th><td class="num">{num(r.contentMargin ?? 0)} pt</td><td>{runtimeLabel(r.runtime)}</td></tr>
        })}
      </tbody>
    </table>
  </div>

  <h2 id="size-classes">Size classes</h2>
  <div class="prose">
    <p>
      iOS reports a horizontal and a vertical size class, each compact or regular. Android's window
      size classes come from the window's size, not the device: compact, medium and expanded, and in
      their V2 form large and extra-large widths too. Width × height, from each device's current
      reading:
    </p>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Device</th><th scope="col">Natural orientation</th><th scope="col">Turned</th></tr></thead>
      <tbody>
        {DEVICES.map((d) => {
          const r = headlineReading(d)
          const t = otherOrientation(d, r)
          const sc = (x?: Reading) => (x?.sizeClass ? `${x.sizeClass.width} × ${x.sizeClass.height}` : '—')
          return <tr><th scope="row"><a href={`/devices/${d.id}`}>{d.name}</a></th><td>{sc(r)}</td><td>{sc(t)}</td></tr>
        })}
      </tbody>
    </table>
  </div>

  <h2 id="foldables">Foldables</h2>
  <div class="prose">
    <p>
      A foldable shows its cover screen closed and its inner screen open. The fold is reported only
      on the inner screen: on the iPhone Duo as a band with margins either side, on Android as a line.
      It separates the content into two halves only when the device is half open.
    </p>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Device</th><th scope="col">Screen</th><th scope="col">Window</th><th scope="col">Fold</th></tr></thead>
      <tbody>
        {foldables.flatMap((d) => (d.screens ?? []).map((s) => {
          const r = currentReadings(d).filter((x) => x.screen === s.id).sort((a, b) => a.rotation - b.rotation)[0]
          const f = r?.fold
          return r && (
            <tr>
              <th scope="row"><a href={`/devices/${d.id}`}>{d.name}</a></th>
              <td>{SCREEN_LABEL[s.id]}</td>
              <td class="num">{size(r.window)} {d.unit}</td>
              <td class="num">{f ? `${f.axis}, ${size(f.frame)} at ${num(f.frame.x)}, ${num(f.frame.y)}${f.margin !== null ? `, ${num(f.margin)} margins` : ''}; ${f.separates ? 'separates' : 'does not separate'}` : '—'}</td>
            </tr>
          )
        }))}
      </tbody>
    </table>
  </div>
</Base>
