---
import Base from '../layouts/Base.astro'
import { DATA, DEVICES, corners, headlineReading, insets, readingCount, runtimeCount, runtimeLabel, scaleLabel, size } from '../lib/data.ts'

const description = `Measured screen sizes, safe-area insets, corner radii and system bars of ${DEVICES.length} iPhones, iPads and Android devices, read on Xcode simulators and Android emulators. JSON, CSV and Markdown for coding agents.`
---
<Base title="screens.guide: measured screen sizes, safe areas and corner radii" description={description}>
  <h1>Screen sizes, safe areas and corner radii, as measured</h1>
  <p class="lede">
    Every number on this site was read on an Xcode simulator or an Android emulator: the window,
    the pixels, the safe-area insets, the display's corner radii, the status, navigation and tab
    bars, the content margins and the folds. {DEVICES.length} devices, {runtimeCount()} OS runtime
    builds, {readingCount()} readings. A value no run measured is left empty with the reason.
  </p>
  <p>
    For coding agents: <a href="/data/v1/devices.json">devices.json</a>, <a href="/data/v1/devices.csv">devices.csv</a>, <a href="/data/v1/schema.json">its schema</a>, <a href="/llms.txt">llms.txt</a>, and a Markdown copy of every page. <a href="/agents">How to use them</a>.
  </p>

  <h2>Devices</h2>
  <p>Each row is the device's current reading: the newest release runtime, on the first screen, in its natural orientation.</p>
  <div class="table-wrap">
    <table id="devices">
      <thead>
        <tr>
          <th scope="col">Device</th>
          <th scope="col">Runtime</th>
          <th scope="col">Window</th>
          <th scope="col">Pixels</th>
          <th scope="col">Scale</th>
          <th scope="col">Safe-area insets<br />top / bottom / left / right</th>
          <th scope="col">Corner radius</th>
        </tr>
      </thead>
      <tbody>
        {DEVICES.map((d) => {
          const r = headlineReading(d)
          return (
            <tr>
              <th scope="row"><a href={`/devices/${d.id}`}>{d.name}</a></th>
              <td>{runtimeLabel(r.runtime)}</td>
              <td class="num">{size(r.window)} {d.unit}</td>
              <td class="num">{size(r.pixels)}</td>
              <td class="num">{scaleLabel(d)}</td>
              <td class="num">{r.safeAreaInsets ? insets(r.safeAreaInsets) : '—'}</td>
              <td class="num">{r.cornerRadii.profile ? corners(r.cornerRadii.profile) : r.cornerRadii.measured ? corners(r.cornerRadii.measured) : '—'}</td>
            </tr>
          )
        })}
      </tbody>
    </table>
  </div>
  <p>
    Dataset {DATA.version}, exported {DATA.updated}. iOS lengths are points (pt), Android lengths
    density-independent pixels (dp). <a href="/compare">Compare devices to scale</a>, see <a href="/runtimes">what changed between OS versions</a>, or read <a href="/method">how each value is read</a>.
  </p>
</Base>
