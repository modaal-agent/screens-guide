---
import DeviceDrawing from '../../components/DeviceDrawing.astro'
import DocPage from '../../components/DocPage.astro'
import Legend from '../../components/Legend.astro'
import type { Device } from '../../lib/dataset.ts'
import { DEVICES, SCREEN_LABEL, rotationLabel, size } from '../../lib/data.ts'
import { deviceDoc, figureReadings } from '../../lib/pages/device.ts'

export function getStaticPaths() {
  return DEVICES.map((device) => ({ params: { id: device.id }, props: { device } }))
}

interface Props {
  device: Device
}

const { device: d } = Astro.props
---
<DocPage doc={deviceDoc(d)}>
  <Fragment slot="drawings">
    <h2>The current reading</h2>
    <div class="figures">
      {figureReadings(d).map((r) => (
        <figure>
          <DeviceDrawing device={d} reading={r} />
          <figcaption>{SCREEN_LABEL[r.screen]}, {rotationLabel(r)}: {size(r.window)} {d.unit}</figcaption>
        </figure>
      ))}
    </div>
    <Legend />
  </Fragment>
</DocPage>
