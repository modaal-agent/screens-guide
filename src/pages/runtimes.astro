---
import Base from '../layouts/Base.astro'
import { changes } from '../lib/changes.ts'
import { SCREEN_LABEL, rotationLabel, runtimeLabel } from '../lib/data.ts'

const list = changes()
const devices = [...new Set(list.map((c) => c.device))]
---
<Base title="What changed between iOS versions" description="The bar heights, insets, corner radii and margins that differ between the runtime builds each device was read on.">
  <h1>What changed between OS versions</h1>
  <p class="lede">
    Each row is one value that two runtime builds of the same device read differently, on the same
    screen in the same orientation. Builds that were not read on a device are not compared. A beta
    build is marked; its value can change by the release.
  </p>
  {devices.map((d) => (
    <section>
      <h2><a href={`/devices/${d.id}`}>{d.name}</a></h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th scope="col">Screen</th><th scope="col">Field</th><th scope="col">Values by runtime</th></tr>
          </thead>
          <tbody>
            {list.filter((c) => c.device === d).map((c) => (
              <tr>
                <td>{SCREEN_LABEL[c.screen]}, {rotationLabel(c)}</td>
                <th scope="row">{c.label}</th>
                <td class="num">
                  {c.values.map((v) => (
                    <div>{runtimeLabel(v.runtime)} <code>{v.runtime.build}</code>: {v.text}</div>
                  ))}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
</Base>
