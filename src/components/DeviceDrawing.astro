---
// One reading drawn to scale in its window coordinates: the display's outline with its corners,
// the safe-area insets, the status, navigation and tab bars, the reserved regions, the fold and
// the content margins.
import type { Device, Reading } from '../lib/dataset.ts'
import { capsuleRadius, cornerTuple, roundedRectPath } from '../lib/drawing.ts'
import { insets as fmtInsets, runtimeLabel, size } from '../lib/data.ts'

interface Props {
  device: Device
  reading: Reading
}

const { device, reading: r } = Astro.props
const w = r.window.width
const h = r.window.height
const pad = Math.max(w, h) * 0.02
const id = `clip-${device.id}-${r.runtime.build}-${r.screen}-${r.rotation}`.replace(/[^a-zA-Z0-9-]/g, '-')
const outline = roundedRectPath(0, 0, w, h, cornerTuple(r.cornerRadii.profile ?? r.cornerRadii.measured))
const i = r.safeAreaInsets
const insetPath = i
  ? `M0,0 H${w} V${h} H0 Z M${i.left},${i.top} V${h - i.bottom} H${w - i.right} V${i.top} Z`
  : null
const nav = r.navigationBar.inline
const tab = r.tabBar
const margin = r.contentMargin
const fold = r.fold
const title = `${device.name}, ${runtimeLabel(r.runtime)}, ${r.orientation}: ${size(r.window)} ${device.unit}${i ? `, insets ${fmtInsets(i)}` : ''}`
---
<svg class="device" viewBox={`${-pad} ${-pad} ${w + 2 * pad} ${h + 2 * pad}`} role="img" aria-label={title}>
  <title>{title}</title>
  <defs>
    <clipPath id={id}><path d={outline} /></clipPath>
  </defs>
  <path class="d-display" d={outline} stroke-width="1.5" vector-effect="non-scaling-stroke" />
  <g clip-path={`url(#${id})`}>
    {insetPath && <path class="d-inset" d={insetPath} fill-rule="evenodd" />}
    {r.statusBar?.frame && (
      <rect class="d-bar" x={r.statusBar.frame.x} y={r.statusBar.frame.y} width={r.statusBar.frame.width} height={r.statusBar.frame.height} vector-effect="non-scaling-stroke" />
    )}
    {nav && <rect class="d-bar" x="0" y={nav.top} width={w} height={nav.height} vector-effect="non-scaling-stroke" />}
    {tab && (
      <rect class="d-bar" x={tab.frame.x} y={tab.frame.y} width={tab.frame.width} height={tab.frame.height}
        rx={tab.style === 'capsule' ? capsuleRadius(tab.frame) : 0} vector-effect="non-scaling-stroke" />
    )}
    {(r.regions ?? []).map((g) => (
      <rect class="d-region" x={g.frame.x} y={g.frame.y} width={g.frame.width} height={g.frame.height} opacity={g.active ? 1 : 0.45} />
    ))}
    {fold && (fold.frame.width > 0 && fold.frame.height > 0
      ? <rect class="d-fold" x={fold.frame.x} y={fold.frame.y} width={fold.frame.width} height={fold.frame.height} />
      : <line class="d-fold" x1={fold.frame.x} y1={fold.frame.y} x2={fold.frame.x + fold.frame.width} y2={fold.frame.y + fold.frame.height} stroke-width="3" vector-effect="non-scaling-stroke" />)}
    {i && margin !== null && margin > 0 && (
      <g class="d-margin" stroke-width="1" vector-effect="non-scaling-stroke">
        <line x1={i.left + margin} y1={i.top} x2={i.left + margin} y2={h - i.bottom} vector-effect="non-scaling-stroke" />
        <line x1={w - i.right - margin} y1={i.top} x2={w - i.right - margin} y2={h - i.bottom} vector-effect="non-scaling-stroke" />
      </g>
    )}
    {i && <rect class="d-safe" x={i.left} y={i.top} width={w - i.left - i.right} height={h - i.top - i.bottom} stroke-width="1.5" vector-effect="non-scaling-stroke" />}
  </g>
</svg>
